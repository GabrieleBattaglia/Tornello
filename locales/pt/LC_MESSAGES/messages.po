#, python-brace-format
msgid ""
"{nome} ha il torneo nello storico ma non è fra i suoi giocatori: si toglie "
"solo la voce, Elo e partite restano."
msgstr ""
"{nome} tem o torneio no histórico, mas não está entre os jogadores do "
"torneio: só o registro é removido, e o Elo e as partidas permanecem."

#, python-brace-format
msgid ""
"{nome} ha {numero} voci di questo torneo nello storico: se ne toglie "
"l'ultima."
msgstr ""
"{nome} tem {numero} registros deste torneio no histórico: o último é "
"removido."

#, python-brace-format
msgid "{nome} non ha ancora una coppia."
msgstr "{nome} ainda não tem par."

#, python-brace-format
msgid "{nome} non può giocare contro se stesso."
msgstr "{nome} não pode jogar contra si mesmo."

#, python-brace-format
msgid "{nome} si è ritirato dal torneo e non può essere abbinato."
msgstr "{nome} se retirou do torneio e não pode ser emparceirado."

#, python-brace-format
msgid ""
"{nome} è nato nel database con questa finalizzazione, ma ha nello storico "
"anche altre voci: la sua scheda resta, e se ne toglie soltanto questo "
"torneo."
msgstr ""
"{nome} entrou no banco de dados com esta finalização, mas também tem outros "
"registros no histórico: a sua ficha permanece, e só este torneio é removido "
"dela."

#, python-brace-format
msgid ""
"{nome} è nato nel database con questa finalizzazione, ma la sua scheda è "
"cambiata dopo, a mano o con la sincronizzazione FIDE: la scheda resta, con "
"le sue modifiche, e se ne toglie soltanto questo torneo."
msgstr ""
"{nome} entrou no banco de dados com esta finalização, mas a sua ficha foi "
"alterada depois, à mão ou com a sincronização FIDE: a ficha permanece, com "
"as suas alterações, e só este torneio é removido dela."

#, python-brace-format
msgid ""
"{nome} è nato nel database con questa finalizzazione, ma è iscritto anche a "
"un torneo in corso, {tornei}: la sua scheda resta, e se ne toglie soltanto "
"questo torneo."
msgstr ""
"{nome} entrou no banco de dados com esta finalização, mas também está "
"inscrito em um torneio em andamento, {tornei}: a sua ficha permanece, e só "
"este torneio é removido dela."

